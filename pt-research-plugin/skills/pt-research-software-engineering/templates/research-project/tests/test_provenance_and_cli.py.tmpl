"""Provenance metadata and the end-to-end CLI: deterministic results, honest metadata."""

from __future__ import annotations

import json
from datetime import datetime, timezone
from pathlib import Path

import pytest

from @@PACKAGE@@.cli import EXIT_CONFIG, EXIT_OK, main
from @@PACKAGE@@.config import load_config
from @@PACKAGE@@.errors import ConfigError
from @@PACKAGE@@.provenance import canonical_hash, collect_run_metadata, sha256_file

FIXED_NOW = datetime(2026, 1, 2, 3, 4, 5, tzinfo=timezone.utc)
REQUIRED_FIELDS = {
    "schema_version",
    "timestamp_utc",
    "seed",
    "config_hash",
    "git_commit",
    "python_version",
    "platform",
    "dependency_versions",
    "input_hashes",
}


def test_metadata_contains_required_fields(tmp_path: Path) -> None:
    data = tmp_path / "input.txt"
    data.write_text("x\n", encoding="utf-8")
    meta = collect_run_metadata(
        config={"a": 1},
        seed=5,
        input_files={"input": data},
        repo_root=tmp_path,
        now=lambda: FIXED_NOW,
    )
    assert REQUIRED_FIELDS <= set(meta)
    assert meta["timestamp_utc"].startswith("2026-01-02T03:04:05")
    assert meta["input_hashes"]["input"] == sha256_file(data)
    assert meta["seed"] == 5


def test_canonical_hash_ignores_key_order() -> None:
    assert canonical_hash({"a": 1, "b": 2}) == canonical_hash({"b": 2, "a": 1})


def test_cli_outputs_are_deterministic(tmp_path: Path, default_config_path: Path) -> None:
    config = str(default_config_path)
    for name in ("one", "two"):
        assert main(["run", "--config", config, "--output-dir", str(tmp_path / name)]) == EXIT_OK
    for artifact in ("results.json", "trajectory.csv"):
        first = (tmp_path / "one" / artifact).read_bytes()
        assert first == (tmp_path / "two" / artifact).read_bytes()
    meta = json.loads((tmp_path / "one" / "run_metadata.json").read_text(encoding="utf-8"))
    assert meta["seed"] == load_config(default_config_path).run.seed
    assert meta["input_hashes"]["config"] == sha256_file(default_config_path)


def test_invalid_config_returns_config_exit_code(tmp_path: Path) -> None:
    bad = tmp_path / "bad.toml"
    bad.write_text("[model]\nmass_kg = -1.0\n", encoding="utf-8")
    assert main(["run", "--config", str(bad)]) == EXIT_CONFIG
    with pytest.raises(ConfigError):
        load_config(bad)
