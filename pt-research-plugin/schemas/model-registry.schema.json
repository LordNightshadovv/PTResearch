{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt-research.local/schemas/model-registry.schema.json",
  "title": "PT candidate model registry",
  "type": "object",
  "required": ["candidates", "selected_candidate_ids"],
  "properties": {
    "candidates": {"type": "array", "items": {"type": "object", "required": ["id", "name", "status", "variables", "assumptions"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "status": {"type": "string", "enum": ["selected_working_baseline", "retained_competitor", "rejected", "unresolved", "selected", "filtered", "component_only"]}, "candidate_kind": {"type": "string", "enum": ["minimal_analytical", "competing_mechanism", "higher_fidelity_numerical", "empirical_baseline", "component"]}, "decision_reason": {"type": "string"}, "causal_mechanism": {"type": "string"}, "governing_equation_ids": {"type": "array", "items": {"type": "string"}}, "validity_range": {"type": "string"}, "predicted_observables": {"type": "array", "items": {"type": "string"}}, "identifiable_parameters": {"type": "array", "items": {"type": "string"}}, "decisive_falsifier": {"type": "string"}, "discriminating_experiment": {"type": "object"}, "computational_cost": {"type": "string"}, "solver_needs": {"type": "string"}, "evidence_quality": {"type": "string"}, "comparison_scores": {"type": "object"}, "variables": {"type": "array", "items": {"type": "object", "required": ["symbol", "unit"], "properties": {"symbol": {"type": "string"}, "unit": {"type": "string"}}}}, "assumptions": {"type": "array", "items": {"type": "string"}}, "prohibited_assumptions": {"type": "array", "items": {"type": "string"}}}}},
    "selected_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "selection_outcome": {"type": "string", "enum": ["selected_working_baseline", "unresolved", "no_candidate_justified", "single_sufficient_working_model", "coupled_model_stack", "competing_whole_chain_models", "insufficient_evidence_to_select"]},
    "single_candidate_exception": {"type": "string"},
    "comparison_table": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "explains", "limitations", "required_parameters", "experimental_discriminator"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "explains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_parameters": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "experimental_discriminator": {"type": "string", "minLength": 1}
        }
      }
    },
    "selection_rationale_against_alternatives": {"type": "string"},
    "stopping_decision": {
      "type": "object",
      "required": ["status", "rationale", "blocking_items", "allowed_claim_level", "resumption_conditions"],
      "properties": {
        "status": {"type": "string", "enum": ["continue", "stop_unresolved_mechanism", "stop_insufficient_literature", "stop_missing_data"]},
        "rationale": {"type": "string", "minLength": 1},
        "blocking_items": {"type": "array", "items": {"type": "string"}},
        "allowed_claim_level": {"type": "string", "enum": ["working_model", "competing_hypotheses", "qualitative_only", "no_scientific_conclusion"]},
        "resumption_conditions": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": true
}
