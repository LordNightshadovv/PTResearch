"""Run metadata (provenance) writer: what ran, on what, with which inputs."""

from __future__ import annotations

import hashlib
import json
import os
import platform
import subprocess
import sys
from collections.abc import Callable, Mapping
from datetime import datetime, timezone
from importlib import metadata
from pathlib import Path
from typing import Any

SCHEMA_VERSION = 1
TRACKED_DISTRIBUTIONS = ("numpy", "scipy", "@@PROJECT_NAME@@")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_hash(value: Any) -> str:
    """SHA-256 of canonical JSON (sorted keys, no whitespace) for config-like data."""
    text = json.dumps(value, sort_keys=True, separators=(",", ":"), default=str)
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def _git(args: list[str], cwd: Path) -> str | None:
    try:
        completed = subprocess.run(
            ["git", *args], cwd=cwd, capture_output=True, text=True, check=True, timeout=10
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return completed.stdout.strip()


def _dependency_versions(names: tuple[str, ...]) -> dict[str, str | None]:
    versions: dict[str, str | None] = {}
    for name in names:
        try:
            versions[name] = metadata.version(name)
        except metadata.PackageNotFoundError:
            versions[name] = None
    return versions


def collect_run_metadata(
    *,
    config: Mapping[str, Any],
    seed: int,
    input_files: Mapping[str, Path] | None = None,
    repo_root: Path | None = None,
    lockfile: Path | None = None,
    now: Callable[[], datetime] = lambda: datetime.now(timezone.utc),
) -> dict[str, Any]:
    """Collect reproducibility metadata. Missing facts are recorded as ``None``, never guessed."""
    root = repo_root or Path.cwd()
    status = _git(["status", "--porcelain"], root)
    return {
        "schema_version": SCHEMA_VERSION,
        "timestamp_utc": now().astimezone(timezone.utc).isoformat(),
        "seed": seed,
        "config_hash": canonical_hash(config),
        "git_commit": _git(["rev-parse", "HEAD"], root),
        "git_dirty": None if status is None else bool(status),
        "python_version": sys.version.split()[0],
        "platform": platform.platform(),
        "dependency_versions": _dependency_versions(TRACKED_DISTRIBUTIONS),
        "lockfile_sha256": sha256_file(lockfile) if lockfile and lockfile.is_file() else None,
        "input_hashes": {
            name: sha256_file(path) for name, path in sorted((input_files or {}).items())
        },
        "argv": list(sys.argv),
    }


def write_run_metadata(path: Path, run_metadata: Mapping[str, Any]) -> None:
    """Atomically write metadata as sorted, indented JSON."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(run_metadata, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    os.replace(temporary, path)
