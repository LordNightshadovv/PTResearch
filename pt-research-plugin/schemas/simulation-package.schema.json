{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt-research.local/schemas/simulation-package.schema.json",
  "title": "PT executable simulation package manifest",
  "type": "object",
  "required": [
    "package_version",
    "simulation_contract_version",
    "route",
    "model_id",
    "primary_solver",
    "solver_version",
    "package_revision",
    "scientific_readiness",
    "software_readiness",
    "implementation",
    "entrypoints",
    "input_schema",
    "synthetic_example",
    "numerical_verification",
    "parameter_mapping",
    "claim_ceiling",
    "runnable_claim"
  ],
  "properties": {
    "package_version": {"type": "integer", "minimum": 1},
    "simulation_contract_version": {"type": "integer", "const": 1},
    "route": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "primary_solver": {"type": "string", "minLength": 1},
    "scientific_readiness": {"type": "string", "enum": ["scientific_stop", "model_selected_not_closed", "model_closed"]},
    "software_readiness": {"type": "string", "enum": ["not_applicable", "handoff_only", "implementation_ready", "runnable_synthetic", "runnable_apparatus", "executed_unverified", "numerically_verified", "experimentally_compared"]},
    "implementation": {"type": "object", "required": ["source_files", "case_generator", "result_extractor"], "properties": {"source_files": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "solver_native_files": {"type": "array", "items": {"type": "string"}}, "case_generator": {"type": "string", "minLength": 1}, "result_extractor": {"type": "string", "minLength": 1}}},
    "entrypoints": {"type": "object", "required": ["check_system", "run_gate", "generate_case", "run", "extract_results"], "properties": {"check_system": {"type": "string"}, "run_gate": {"type": "string"}, "generate_case": {"type": "string"}, "run": {"type": "string"}, "extract_results": {"type": "string"}}},
    "input_schema": {"type": "string", "minLength": 1},
    "synthetic_example": {"type": "string", "minLength": 1},
    "numerical_verification": {"type": "string", "minLength": 1},
    "parameter_mapping": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "runnable_claim": {"type": "boolean"},
    "solver_version": {"type": "string", "minLength": 1},
    "package_revision": {"type": "string", "minLength": 1},
    "platform": {"type": "object"},
    "receipts": {"type": "string"}
  },
  "additionalProperties": true
}
