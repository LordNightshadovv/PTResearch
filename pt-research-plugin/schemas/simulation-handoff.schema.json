{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt-research.local/schemas/simulation-handoff.schema.json",
  "title": "PT external-solver adapter and simulation-state evidence",
  "type": "object",
  "required": ["simulation_contract_version", "primary_solver", "version_policy", "solver_distribution", "highest_state", "scientific_readiness", "software_readiness", "claim_ceiling", "state_evidence", "official_installation_source", "documentation_locator", "parameter_mapping", "boundary_and_initial_conditions", "discretization_plan", "controls", "output_extraction", "verification_plan", "validation_plan", "beginner_readme"],
  "properties": {
    "simulation_contract_version": {"type": "integer", "const": 1},
    "primary_solver": {"type": "string", "minLength": 1},
    "version_policy": {"type": "string", "minLength": 1},
    "solver_distribution": {"type": "string", "enum": ["external_reference", "shared_installer_reference", "embedded_redistributable"]},
    "highest_state": {"type": "string", "enum": ["not_applicable", "solver_selected_only", "installation_package_prepared", "parameter_handoff_validated", "solver_case_generator_prepared", "solver_native_case_generated", "smoke_tested", "executed", "numerically_verified", "experimentally_validated", "handoff_only", "implementation_ready", "runnable_synthetic", "runnable_apparatus", "executed_unverified", "experimentally_compared"]},
    "scientific_readiness": {"type": "string", "enum": ["scientific_stop", "model_selected_not_closed", "model_closed"]},
    "software_readiness": {"type": "string", "enum": ["not_applicable", "handoff_only", "implementation_ready", "runnable_synthetic", "runnable_apparatus", "executed_unverified", "numerically_verified", "experimentally_compared"]},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "state_evidence": {"type": "array", "items": {"type": "object"}},
    "official_installation_source": {"type": "string", "minLength": 1},
    "documentation_locator": {"type": "string", "minLength": 1},
    "parameter_mapping": {"type": "array", "items": {"type": "object", "required": ["parameter", "destination_kind", "destination", "equation_id", "implemented_file", "implemented_symbol", "units", "notation_conversion", "discretization_or_approximation", "implementation_assumptions"], "properties": {"parameter": {"type": "string", "minLength": 1}, "destination_kind": {"type": "string", "minLength": 1}, "destination": {"type": "string", "minLength": 1}, "equation_id": {"type": "string", "minLength": 1}, "implemented_file": {"type": "string", "minLength": 1}, "implemented_symbol": {"type": "string", "minLength": 1}, "units": {"type": "string", "minLength": 1}, "notation_conversion": {"type": "string", "minLength": 1}, "discretization_or_approximation": {"type": "string", "minLength": 1}, "implementation_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "boundary_and_initial_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "discretization_plan": {"type": "string", "minLength": 1},
    "controls": {"type": "string", "minLength": 1},
    "output_extraction": {"type": "string", "minLength": 1},
    "verification_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "beginner_readme": {"type": "string", "minLength": 1},
    "validation_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["experiment_measurement", "simulation_input", "solver_quantity", "output_metric", "comparison_method", "uncertainty_treatment", "acceptance_criterion"],
        "properties": {
          "experiment_measurement": {"type": "string", "minLength": 1},
          "simulation_input": {"type": "string", "minLength": 1},
          "solver_quantity": {"type": "string", "minLength": 1},
          "output_metric": {"type": "string", "minLength": 1},
          "comparison_method": {"type": "string", "minLength": 1},
          "uncertainty_treatment": {"type": "string", "minLength": 1},
          "acceptance_criterion": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "additionalProperties": true
}
