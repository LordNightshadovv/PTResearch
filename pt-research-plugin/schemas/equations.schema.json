{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt-research.local/schemas/equations.schema.json",
  "title": "PT equation provenance and mechanistic-closure registry",
  "type": "object",
  "required": ["equations"],
  "properties": {
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "latex", "role", "provenance_class", "derivation_steps", "assumptions", "dimensional_check", "limiting_cases", "falsifier", "symbols", "produces"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "latex": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["governing", "constitutive", "boundary", "scaling", "empirical", "numerical", "observation", "closure"]},
          "provenance_class": {"type": "string", "enum": ["verbatim_source_equation", "adapted_source_equation", "derived_from_cited_principles", "original_derivation", "empirical_fit_from_data", "assumed_placeholder_pending_measurement"]},
          "source_claims": {"type": "array", "items": {"type": "object"}},
          "derivation_steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "dimensional_check": {"type": "string", "minLength": 1},
          "limiting_cases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "falsifier": {"type": "string", "minLength": 1},
          "symbols": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "produces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "closes_variables": {"type": "array", "items": {"type": "string"}},
          "transformation_map": {"type": "object"},
          "starting_principles": {"type": "array", "items": {"type": "object"}},
          "lineage": {
            "type": "object",
            "required": ["source_basis", "original_equation", "assumptions", "transformations_made", "final_equation", "adaptation_justification"],
            "properties": {
              "source_basis": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["source_id", "source_title", "source_authors", "exact_locator"],
                  "properties": {
                    "source_id": {"type": "string", "minLength": 1},
                    "source_title": {"type": "string", "minLength": 1},
                    "source_authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "exact_locator": {
                      "type": "object",
                      "required": ["availability"],
                      "properties": {
                        "availability": {"type": "string", "enum": ["verified", "unavailable"]},
                        "chapter": {"type": "string"},
                        "section": {"type": "string"},
                        "pages": {"type": "string"},
                        "equation": {"type": "string"},
                        "figure": {"type": "string"},
                        "table": {"type": "string"},
                        "appendix": {"type": "string"},
                        "url_anchor": {"type": "string"},
                        "unavailable_reason": {"type": "string"},
                        "searches_performed": {"type": "array", "items": {"type": "string"}}
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              },
              "original_equation": {"type": "string", "minLength": 1},
              "assumptions": {"type": "array", "items": {"type": "string"}},
              "transformations_made": {"type": "array", "items": {"type": "string"}},
              "final_equation": {"type": "string", "minLength": 1},
              "adaptation_justification": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "additionalProperties": true
}
