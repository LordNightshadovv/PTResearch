{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt-research.local/schemas/apparatus-fidelity.schema.json",
  "title": "PT apparatus reconstruction and model-fidelity audit",
  "type": "object",
  "required": ["geometry_topology", "features", "observable", "parameter_ranges"],
  "properties": {
    "geometry_topology": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["apparatus_feature", "model_representation", "match_status", "justification", "consequence_if_wrong", "required_measurement_or_source"],
        "properties": {
          "apparatus_feature": {"type": "string", "minLength": 1},
          "model_representation": {"type": "string", "minLength": 1},
          "match_status": {"type": "string", "enum": ["matched", "approximated", "unknown", "contradicted"]},
          "justification": {"type": "string", "minLength": 1},
          "consequence_if_wrong": {"type": "string", "minLength": 1},
          "required_measurement_or_source": {"type": "string", "minLength": 1}
        }
      }
    },
    "observable": {"type": "string", "minLength": 1},
    "parameter_ranges": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": true
}
