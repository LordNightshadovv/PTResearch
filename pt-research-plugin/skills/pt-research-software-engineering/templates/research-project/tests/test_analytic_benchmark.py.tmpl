"""Verification against exact solutions, limiting cases, and symmetry."""

from __future__ import annotations

import numpy as np
import pytest

from @@PACKAGE@@.analytic import underdamped_position
from @@PACKAGE@@.model import DampedOscillator
from @@PACKAGE@@.solver import simulate

T_END = 2.0
T_EVAL = np.linspace(0.0, T_END, 201)


def numerical_position(model: DampedOscillator, x0: float, v0: float) -> np.ndarray:
    trajectory = simulate(
        model, np.array([x0, v0]), T_END, T_EVAL, method="DOP853", rtol=1e-11, atol=1e-13
    )
    return trajectory.y[0]


def test_matches_exact_solution() -> None:
    model = DampedOscillator(0.25, 40.0, 0.1)
    expected = underdamped_position(model, 0.02, 0.1, T_EVAL)
    assert np.max(np.abs(numerical_position(model, 0.02, 0.1) - expected)) < 1e-9


def test_undamped_limit_is_cosine() -> None:
    """Limiting case c -> 0: x(t) = x0 cos(w0 t) when v0 = 0."""
    model = DampedOscillator(0.25, 40.0, 0.0)
    expected = 0.02 * np.cos(model.omega0_rad_per_s * T_EVAL)
    assert np.max(np.abs(numerical_position(model, 0.02, 0.0) - expected)) < 1e-9


def test_reflection_symmetry() -> None:
    """The linear system is odd under (x0, v0) -> (-x0, -v0)."""
    model = DampedOscillator(0.25, 40.0, 0.3)
    forward = numerical_position(model, 0.02, 0.05)
    mirrored = numerical_position(model, -0.02, -0.05)
    assert np.allclose(forward, -mirrored, atol=1e-12)


def test_linear_scaling_of_amplitude() -> None:
    model = DampedOscillator(0.25, 40.0, 0.3)
    small = numerical_position(model, 0.01, 0.0)
    large = numerical_position(model, 0.05, 0.0)
    assert np.allclose(large, 5.0 * small, atol=1e-11)


def test_invalid_parameters_are_rejected() -> None:
    with pytest.raises(ValueError):
        DampedOscillator(-1.0, 40.0, 0.1)
    with pytest.raises(ValueError):
        underdamped_position(DampedOscillator(1.0, 1.0, 10.0), 1.0, 0.0, T_EVAL)
