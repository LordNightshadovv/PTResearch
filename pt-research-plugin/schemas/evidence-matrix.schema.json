{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt-research.local/schemas/evidence-matrix.schema.json",
  "title": "PT claim-level evidence sufficiency matrix",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "importance", "source_ids", "directness", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "importance": {"type": "string", "enum": ["central_quantitative", "central_qualitative", "supporting", "contextual"]},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "directness": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["direct_same_apparatus", "direct_same_mechanism", "canonical_theory", "parameter_data", "numerical_method", "contextual_only", "official_prompt_only"]}},
          "status": {"type": "string", "enum": ["sufficient", "warning", "blocking", "unresolved"]},
          "evidence_direction": {"type": "string", "enum": ["supporting", "opposing", "mixed", "limiting"]}
        }
      }
    },
    "negative_evidence_review": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "supporting_evidence_ids", "opposing_evidence_ids", "opposing_search_outcome", "limitations", "competing_interpretations"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "opposing_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "opposing_search_outcome": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "competing_interpretations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
